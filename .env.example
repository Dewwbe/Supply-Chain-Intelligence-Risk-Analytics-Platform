# Copy to .env and adjust:   cp .env.example .env
# Every value below has a working default for local Docker Compose; only the
# Kaggle credentials are required (to download the source datasets).
# Never commit the real .env — it is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (host-side; the api container overrides this to reach `postgres`) ---
DATABASE_URL=postgresql+psycopg://gulfmart:gulfmart@localhost:5432/gulfmart_analytics

# --- Host ports used by docker-compose.yml (change if something already uses them,
#     e.g. a native Windows Postgres on 5432 — then update DATABASE_URL to match) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# --- Cache: "memory" (single process) or "redis" (shared across API workers) ---
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
KPI_CACHE_TTL_SECONDS=300
FORECAST_CACHE_TTL_SECONDS=3600
ANOMALY_CACHE_TTL_SECONDS=3600

# --- API rate limits (per client IP) and outbound throttling ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_EXPENSIVE=10/minute
EXTERNAL_API_RATE_PER_SECOND=2.0

# --- Kaggle API (required: downloads Olist and DataCo via
#     `python -m etl.extract.download_raw --all`). Create a token at
#     https://www.kaggle.com/settings -> API -> Create New Token ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- UAE Open Data Portal (bayanat.ae): public endpoints, no key required ---
UAE_OPEN_DATA_BASE_URL=https://bayanat.ae/en/dataset
