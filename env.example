ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (local Docker Compose defaults — no signup needed) ---
DATABASE_URL=postgresql+psycopg://gulfmart:gulfmart@localhost:5432/gulfmart_analytics

# --- Cache ---
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
KPI_CACHE_TTL_SECONDS=300
FORECAST_CACHE_TTL_SECONDS=3600

# --- API rate limiting / outbound throttling ---
RATE_LIMIT_DEFAULT=60/minute
EXTERNAL_API_RATE_PER_SECOND=2.0

# --- Kaggle API (required to download Olist, DataCo, M5 via the CLI/API
#     instead of manual browser downloads — see "How to obtain" below) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- NOAA Climate Data Online token (optional — only needed if you add
#     the weather layer; not required for the core project) ---
NOAA_CDO_TOKEN=

# --- UAE Open Data Portal (bayanat.ae) ---
# Public open-data endpoints — no API key required as of this writing.
# Leave this as-is; only change it if the portal later requires a key.
UAE_OPEN_DATA_BASE_URL=https://bayanat.ae/en/dataset

# Never commit the real .env — this file is a template only.
