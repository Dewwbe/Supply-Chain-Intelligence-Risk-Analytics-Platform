# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
coverage.xml
.coverage
*.log

# Env / secrets
.env
*.pem
*.key

# Data (never commit raw/processed data)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# BI / reports (binary, kept out of git history; store via release assets or LFS)
powerbi/*.pbix
reports/*.pdf
excel/*.xlsx
powerbi/data/
**/.pbi/localSettings.json
**/.pbi/cache.abf

# OS / IDE
.DS_Store
.idea/
.vscode/
