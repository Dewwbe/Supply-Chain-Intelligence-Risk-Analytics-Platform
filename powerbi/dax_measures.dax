// GulfMart Supply Chain Intelligence Platform — DAX Measure Library (Phase 10)
//
// Every measure below traces to a row in docs/kpi_dictionary.md (cited in
// each comment) — no orphan measures. Grouped by BI page. Ground truth for
// every number is src/kpi/summary.py (all-time, network-wide, no date
// filter baked in — filtering by date/category/etc. is exactly what
// CALCULATE/FILTER/ALL/ALLSELECTED + report-level slicers are for).
//
// Table names below match the TMDL semantic model in
// powerbi/GulfMart Supply Chain.SemanticModel/definition/tables/*.tmdl.
// This file is the readable, reviewable source; the .tmdl files carry the
// same expressions embedded as each measure's `expression` property so
// Power BI Desktop picks them up directly on open.

// =====================================================================
// Executive Overview
// =====================================================================

// docs/kpi_dictionary.md §1 "Total Revenue"
Total Revenue = SUM(fact_sales[sales_amount])

// docs/kpi_dictionary.md §1 "Gross Margin" — per-row (unit_cost is on
// dim_product, one row per sale), so SUMX + RELATED, not a flat SUM.
Gross Margin =
SUMX(
    fact_sales,
    fact_sales[sales_amount] - RELATED(dim_product[unit_cost]) * fact_sales[quantity]
)

// Supporting measure for Inventory Turnover below — same formula as
// Gross Margin's cost term, kept separate because COGS (cost) and Gross
// Margin (revenue - cost) answer different questions.
COGS = SUMX(fact_sales, fact_sales[quantity] * RELATED(dim_product[unit_cost]))

// docs/kpi_dictionary.md §2 "Inventory Turnover" = COGS / average
// inventory value. Average Inventory Value (below) already averages over
// days, so DIVIDE is a straight ratio-of-totals, not an average-of-ratios.
Inventory Turnover = DIVIDE([COGS], [Average Inventory Value])

// Time intelligence — requires dim_date marked as the model's Date Table
// (see definition/tables/dim_date.tmdl) with an unbroken date range.
// DATEADD and SAMEPERIODLASTYEAR are two equivalent ways to shift a year
// back; both are included because the spec calls for both functions, not
// because a report should use both for the same thing.
Total Revenue PY (DATEADD) = CALCULATE([Total Revenue], DATEADD(dim_date[full_date], -1, YEAR))

Total Revenue PY (SPLY) = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date]))

// Blank at the data's earliest year (no prior year exists) is expected,
// not a bug — DIVIDE returns BLANK rather than erroring on a blank/zero
// denominator.
Revenue YoY % = DIVIDE([Total Revenue] - [Total Revenue PY (SPLY)], [Total Revenue PY (SPLY)])

// ALL / ALLSELECTED — share of total vs. share of the current selection.
// Filtering dim_product[category] to one category in a slicer changes
// [Total Revenue] but not [Revenue % of All Categories]'s denominator
// (ALL ignores the slicer); [Revenue % of Selected Categories]'s
// denominator *does* track the slicer (ALLSELECTED keeps report-level
// filters, drops only the visual's own local context) — these are
// deliberately different numbers, not two names for the same one.
Revenue % of All Categories = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALL(dim_product[category])))

Revenue % of Selected Categories =
DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED(dim_product[category])))

// =====================================================================
// Sales & Demand
// =====================================================================

// docs/kpi_dictionary.md §1 "Total Units Sold"
Total Units Sold = SUM(fact_sales[quantity])

// docs/kpi_dictionary.md §1 "Average Order Value (AOV)" — DISTINCTCOUNT
// because one order can have several fact_sales line items.
Average Order Value = DIVIDE([Total Revenue], DISTINCTCOUNT(fact_sales[order_id]))

// docs/kpi_dictionary.md §1 "Return Rate"
Return Rate = DIVIDE(SUM(fact_returns[returned_quantity]), [Total Units Sold])

// =====================================================================
// Inventory
// =====================================================================

// docs/kpi_dictionary.md §2 "Inventory Value" — a balance-sheet snapshot,
// not a sum across every historical day. fact_inventory rows end on a
// different date per product (Phase 3's simulator scopes each product to
// its own observed sales range — see src/kpi/summary.py's docstring for
// the exact bug this would otherwise cause), so "current" means each
// product's own most recent row, found via CALCULATE+ALLEXCEPT inside
// FILTER, then summed with SUMX.
Inventory Value =
SUMX(
    FILTER(
        fact_inventory,
        fact_inventory[date_key]
            = CALCULATE(MAX(fact_inventory[date_key]), ALLEXCEPT(fact_inventory, fact_inventory[product_key]))
    ),
    fact_inventory[closing_stock] * RELATED(dim_product[unit_cost])
)

// docs/kpi_dictionary.md §2 "Stockout Rate"
Stockout Rate = DIVIDE(CALCULATE(COUNTROWS(fact_inventory), fact_inventory[closing_stock] = 0), COUNTROWS(fact_inventory))

// docs/kpi_dictionary.md §2 "Fill Rate" — same unmet-demand proxy as
// sql/07_kpi/executive_summary.sql: stock that should have depleted via
// sales beyond what was actually recorded as sold. MAX(a, b) is DAX's
// 2-argument scalar form (not the aggregation form), used here per row
// inside SUMX's row context.
Fill Rate =
VAR SoldQty = SUM(fact_inventory[sold_quantity])
VAR UnmetQty =
    SUMX(
        fact_inventory,
        MAX(0, fact_inventory[opening_stock] - fact_inventory[closing_stock] - fact_inventory[received_quantity])
    )
RETURN DIVIDE(SoldQty, SoldQty + UnmetQty)

// docs/kpi_dictionary.md §2 "Inventory Turnover" support measure — total
// portfolio value per day (opening/closing average, at cost), then
// averaged across days; not a flat row-level mean, which would misweight
// products with more or fewer days of history in the model.
Average Inventory Value =
AVERAGEX(
    VALUES(dim_date[full_date]),
    CALCULATE(
        SUMX(
            fact_inventory,
            (fact_inventory[opening_stock] + fact_inventory[closing_stock]) / 2 * RELATED(dim_product[unit_cost])
        )
    )
)

// =====================================================================
// Supplier & Logistics
// =====================================================================

// docs/kpi_dictionary.md §3 "Average Lead Time" — fact_shipments has two
// date-key columns pointing at the same dim_date table (order date,
// actual delivery date); only one relationship can be active at a time in
// a star schema without USERELATIONSHIP, so LOOKUPVALUE resolves the
// second (inactive) role directly inside AVERAGEX's row context instead.
Average Lead Time =
AVERAGEX(
    fact_shipments,
    LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[actual_delivery_date_key])
        - LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[order_date_key])
)

// docs/kpi_dictionary.md §3 "Lead-Time Std Dev"
Lead-Time Std Dev =
AVERAGEX(
    VALUES(dim_supplier[supplier_key]),
    STDEVX.P(
        fact_shipments,
        LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[actual_delivery_date_key])
            - LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[order_date_key])
    )
)

// docs/kpi_dictionary.md §3 "Supplier OTD (On-Time Delivery)"
Supplier OTD =
DIVIDE(
    CALCULATE(
        COUNTROWS(fact_shipments),
        FILTER(fact_shipments, fact_shipments[actual_delivery_date_key] <= fact_shipments[expected_delivery_date_key])
    ),
    CALCULATE(COUNTROWS(fact_shipments), NOT ISBLANK(fact_shipments[actual_delivery_date_key]))
)

// docs/kpi_dictionary.md §3 "Transport Cost"
Transport Cost = SUM(fact_shipments[transport_cost])

// docs/kpi_dictionary.md §3 "Cancellation Rate"
Cancellation Rate =
DIVIDE(
    CALCULATE(COUNTROWS(fact_purchase_orders), fact_purchase_orders[order_status] = "Cancelled"),
    COUNTROWS(fact_purchase_orders)
)

// docs/kpi_dictionary.md §3 "Cost Variability" — per supplier, then
// averaged for a single-number card; a table/matrix visual can instead
// put dim_supplier[supplier_name] on rows to see it un-averaged.
Cost Variability =
AVERAGEX(
    VALUES(dim_supplier[supplier_key]),
    DIVIDE(CALCULATE(STDEVX.P(fact_purchase_orders, fact_purchase_orders[unit_cost])), CALCULATE(AVERAGE(fact_purchase_orders[unit_cost])))
)

// docs/kpi_dictionary.md §4 "Supplier Risk Score" / "Supplier Risk Level"
// — computed in src/supplier_risk/scoring.py (Phase 7), not recomputed in
// DAX; supplier_risk_scores (Power Query, reports/supplier_risk/
// supplier_risk_scores.csv) is a plain lookup table, so these are trivial
// pass-through measures, not orphans.
Supplier Risk Score = AVERAGE(supplier_risk_scores[risk_score])

Supplier Risk Level = SELECTEDVALUE(supplier_risk_scores[risk_level])

// =====================================================================
// Scenario Simulator — mirrors src/scenario_model/engine.py exactly
// (docs/kpi_dictionary.md §7). Uses 3 What-If Parameters (Modeling > New
// Parameter in Desktop) as the sliders: Demand Change %, Lead Time
// Change %, Transport Cost Change %, each with its own disconnected
// single-column table + [<Parameter> Value] measure — see
// definition/tables/*Parameter*.tmdl.
//
// DAX measures cannot take arguments, so neither of the two normal-
// distribution functions engine.py needs (scipy's norm.ppf and norm.cdf;
// Excel has native NORM.S.INV/NORM.S.DIST, DAX has neither) can be
// factored into a single reusable "function" measure the way run_scenario()
// does in Python — each is instead computed at the one specific value it's
// needed for, inline:
//   - Implied Safety Stock needs the inverse CDF at exactly one probability
//     (the baseline stockout rate) -> Peter Acklam's closed-form rational
//     approximation (measured max abs error ~3.9e-9 without the optional
//     Halley's-method refinement step, which is not included here),
//     computed once.
//   - Scenario Stockout Rate needs the forward CDF at exactly one z (the
//     standardized distance between the calibrated safety stock and the
//     scenario's shifted demand distribution) -> the Zelen & Severo (1964)
//     rational approximation (max abs error ~7.5e-8), computed once.
// Both are verified against scipy.stats.norm in
// tests/unit/test_dax_normal_approximations.py, which transcribes the
// identical formulas into Python and diffs them against scipy across a
// grid — see that file for the measured error bounds.
// =====================================================================

// Baseline (actual) figures — filter context is the whole model, no
// scenario parameters applied. These map 1:1 onto src/scenario_model
// /data.py's BaselineMetrics fields. Baseline Avg Daily Demand/Std use
// all-time history here, vs. engine.py's 90-day recent window — a
// deliberate difference (Power BI's own date slicer is the mechanism for
// narrowing the window in this layer, not a fixed Python-side constant),
// not an oversight.
Baseline Avg Daily Demand = DIVIDE([Total Units Sold], DISTINCTCOUNT(fact_sales[date_key]))

Baseline Daily Demand Std =
STDEVX.P(
    ADDCOLUMNS(VALUES(dim_date[full_date]), "@DailyQty", CALCULATE(SUM(fact_sales[quantity]))),
    [@DailyQty]
)

Baseline Avg Lead Time = [Average Lead Time]

Baseline Stockout Rate = [Stockout Rate]

Baseline Inventory Value = [Inventory Value]

Baseline Transport Cost = [Transport Cost]

Baseline Revenue = [Total Revenue]

// Scenario (what-if) factors from the 3 slider parameters. Each parameter
// is a disconnected GENERATESERIES table created by Desktop's What-If
// wizard (Modeling > New Parameter > Numeric range); its single column is
// named after the table:
//   Demand Change Parameter:          -20 to 30,  step 1
//   Lead Time Change Parameter:       -30 to 50,  step 1
//   Transport Cost Change Parameter:  -20 to 40,  step 1
Demand Change % Value = SELECTEDVALUE('Demand Change Parameter'[Demand Change Parameter], 0)

Lead Time Change % Value = SELECTEDVALUE('Lead Time Change Parameter'[Lead Time Change Parameter], 0)

Transport Cost Change % Value = SELECTEDVALUE('Transport Cost Change Parameter'[Transport Cost Change Parameter], 0)

Scenario Demand Factor = 1 + DIVIDE([Demand Change % Value], 100)

Scenario Lead Time Factor = 1 + DIVIDE([Lead Time Change % Value], 100)

Scenario Cost Factor = 1 + DIVIDE([Transport Cost Change % Value], 100)

// The stock-on-hand level that reproduces the real observed baseline
// stockout rate under baseline demand/lead-time — see engine.py's
// _implied_safety_stock docstring for the full rationale. Inverse CDF via
// Peter Acklam's approximation (3 regions: low tail, central, high tail).
Implied Safety Stock =
VAR Mean = [Baseline Avg Daily Demand] * [Baseline Avg Lead Time]
VAR Std = [Baseline Daily Demand Std] * SQRT([Baseline Avg Lead Time])
VAR Rate = MIN(MAX([Baseline Stockout Rate], 0.0001), 0.9999)
VAR P = 1 - Rate // z = ppf(1 - rate), per engine.py
VAR PLow = 0.02425
VAR PHigh = 1 - PLow
VAR QLow = SQRT(-2 * LN(P))
VAR ZLowTail =
    (((((-0.007784894002430293 * QLow - 0.3223964580411365) * QLow - 2.400758277161838) * QLow
        - 2.549732539343734) * QLow + 4.374664141464968) * QLow + 2.938163982698783)
    / ((((0.007784695709041462 * QLow + 0.3224671290700398) * QLow + 2.445134137142996) * QLow
        + 3.754408661907416) * QLow + 1)
VAR QMid = P - 0.5
VAR RMid = QMid * QMid
VAR ZMid =
    (((((-39.69683028665376 * RMid + 220.9460984245205) * RMid - 275.9285104469687) * RMid
        + 138.3577518672690) * RMid - 30.66479806614716) * RMid + 2.506628277459239) * QMid
    / (((((-54.47609879822406 * RMid + 161.5858368580409) * RMid - 155.6989798598866) * RMid
        + 66.80131188771972) * RMid - 13.28068155288572) * RMid + 1)
VAR QHigh = SQRT(-2 * LN(1 - P))
VAR ZHighTail =
    -(((((-0.007784894002430293 * QHigh - 0.3223964580411365) * QHigh - 2.400758277161838) * QHigh
        - 2.549732539343734) * QHigh + 4.374664141464968) * QHigh + 2.938163982698783)
    / ((((0.007784695709041462 * QHigh + 0.3224671290700398) * QHigh + 2.445134137142996) * QHigh
        + 3.754408661907416) * QHigh + 1)
VAR Z = IF(P < PLow, ZLowTail, IF(P > PHigh, ZHighTail, ZMid))
RETURN Mean + Z * Std

// Stock-out probability under the scenario's shifted demand distribution,
// against the fixed (policy-unchanged) Implied Safety Stock — mirrors
// run_scenario()'s branch on scenario_std exactly. Forward CDF via the
// Zelen & Severo (1964) rational approximation.
Scenario Stockout Rate =
VAR DemandFactor = [Scenario Demand Factor]
VAR LeadTimeFactor = [Scenario Lead Time Factor]
VAR ScenarioMean = [Baseline Avg Daily Demand] * DemandFactor * ([Baseline Avg Lead Time] * LeadTimeFactor)
VAR ScenarioStd = [Baseline Daily Demand Std] * DemandFactor * SQRT([Baseline Avg Lead Time] * LeadTimeFactor)
VAR SafetyStock = [Implied Safety Stock]
VAR Z = DIVIDE(SafetyStock - ScenarioMean, ScenarioStd)
VAR AbsZ = ABS(Z)
VAR T = DIVIDE(1, 1 + 0.2316419 * AbsZ)
VAR Poly =
    T * (0.319381530
        + T * (-0.356563782
        + T * (1.781477937
        + T * (-1.821255978
        + T * 1.330274429))))
VAR Pdf = DIVIDE(1, SQRT(2 * PI())) * EXP(-0.5 * Z * Z)
VAR UpperTail = Pdf * Poly
VAR Phi = IF(Z >= 0, 1 - UpperTail, UpperTail) // standard normal CDF at Z
VAR StockoutIfStdPositive = MIN(MAX(1 - Phi, 0), 1)
RETURN IF(ScenarioStd > 0, StockoutIfStdPositive, IF(SafetyStock >= ScenarioMean, 0, 1))

Scenario Fill Rate = 1 - [Scenario Stockout Rate]

Scenario Projected Inventory Value = [Baseline Inventory Value] * [Scenario Demand Factor] * [Scenario Lead Time Factor]

Scenario Projected Transport Cost = [Baseline Transport Cost] * [Scenario Demand Factor] * [Scenario Cost Factor]

Scenario Projected Revenue = [Baseline Revenue] * [Scenario Demand Factor]

// docs/kpi_dictionary.md §7 "Revenue at Risk" — the one genuinely new
// scenario-only KPI; everything else above reuses an existing §1-§3 KPI
// at a "what-if" grain.
Revenue at Risk = [Scenario Projected Revenue] * [Scenario Stockout Rate]
