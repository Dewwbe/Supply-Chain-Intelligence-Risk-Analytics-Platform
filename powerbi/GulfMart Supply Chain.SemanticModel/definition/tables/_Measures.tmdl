table _Measures
	lineageTag: 539b2a22-c748-4f83-b59a-fbe370ddf527
	isHidden: false

	measure 'Total Revenue' = SUM(fact_sales[sales_amount])
		lineageTag: 30dbb7d0-2578-46f5-aac9-ba36027f908b

	measure 'Gross Margin' =
		SUMX(
		    fact_sales,
		    fact_sales[sales_amount] - RELATED(dim_product[unit_cost]) * fact_sales[quantity]
		)
		lineageTag: 56c1f899-1114-477a-b781-a85ad50458b2

	measure 'COGS' = SUMX(fact_sales, fact_sales[quantity] * RELATED(dim_product[unit_cost]))
		lineageTag: 8d0a58f1-176f-4f5d-9ea3-a67a1f7d0922

	measure 'Inventory Turnover' = DIVIDE([COGS], [Average Inventory Value])
		lineageTag: 6df38ce6-0786-4878-92bc-c5a887606071

	measure 'Total Revenue PY (DATEADD)' = CALCULATE([Total Revenue], DATEADD(dim_date[full_date], -1, YEAR))
		lineageTag: 1cc16a46-b4b1-45dc-b675-bac43398f15d

	measure 'Total Revenue PY (SPLY)' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date]))
		lineageTag: 1374cd17-9403-42fc-a952-5de20750aa76

	measure 'Revenue YoY %' = DIVIDE([Total Revenue] - [Total Revenue PY (SPLY)], [Total Revenue PY (SPLY)])
		lineageTag: c5891c65-a32d-4821-9f84-9bb11c0ae902

	measure 'Revenue % of All Categories' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALL(dim_product[category])))
		lineageTag: 1d638774-9547-45ac-9fb2-6ce07f27ec9d

	measure 'Revenue % of Selected Categories' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED(dim_product[category])))
		lineageTag: 23938f41-c7c1-49c9-b4bd-972c40941eb5

	measure 'Total Units Sold' = SUM(fact_sales[quantity])
		lineageTag: 344a443a-0bf3-47fc-9605-408922b47824

	measure 'Average Order Value' = DIVIDE([Total Revenue], DISTINCTCOUNT(fact_sales[order_id]))
		lineageTag: 59986cdb-d4db-4f65-bc2c-86105aba856a

	measure 'Return Rate' = DIVIDE(SUM(fact_returns[returned_quantity]), [Total Units Sold])
		lineageTag: f4a01b8b-7272-4b3c-afc9-e439789daa8c

	measure 'Inventory Value' =
		SUMX(
		    FILTER(
		        fact_inventory,
		        fact_inventory[date_key]
		            = CALCULATE(MAX(fact_inventory[date_key]), ALLEXCEPT(fact_inventory, fact_inventory[product_key]))
		    ),
		    fact_inventory[closing_stock] * RELATED(dim_product[unit_cost])
		)
		lineageTag: b31ab13e-1687-41b0-9af8-1e5b96e4c231

	measure 'Stockout Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_inventory), fact_inventory[closing_stock] = 0), COUNTROWS(fact_inventory))
		lineageTag: 320fd7ee-dcf3-495c-ab83-9ac27dd298bb

	measure 'Fill Rate' =
		VAR SoldQty = SUM(fact_inventory[sold_quantity])
		VAR UnmetQty =
		    SUMX(
		        fact_inventory,
		        MAX(0, fact_inventory[opening_stock] - fact_inventory[closing_stock] - fact_inventory[received_quantity])
		    )
		RETURN DIVIDE(SoldQty, SoldQty + UnmetQty)
		lineageTag: 544eeab7-6d99-4735-866a-bfb08bd648fb

	measure 'Average Inventory Value' =
		AVERAGEX(
		    VALUES(dim_date[full_date]),
		    CALCULATE(
		        SUMX(
		            fact_inventory,
		            (fact_inventory[opening_stock] + fact_inventory[closing_stock]) / 2 * RELATED(dim_product[unit_cost])
		        )
		    )
		)
		lineageTag: 7ba193bc-a32b-4807-9073-919e608da5cb

	measure 'Average Lead Time' =
		AVERAGEX(
		    fact_shipments,
		    LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[actual_delivery_date_key])
		        - LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[order_date_key])
		)
		lineageTag: 0f924d46-b6b5-4b84-946c-06e9dff5f1f0

	measure 'Lead-Time Std Dev' =
		AVERAGEX(
		    VALUES(dim_supplier[supplier_key]),
		    STDEVX.P(
		        fact_shipments,
		        LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[actual_delivery_date_key])
		            - LOOKUPVALUE(dim_date[full_date], dim_date[date_key], fact_shipments[order_date_key])
		    )
		)
		lineageTag: 5311f690-d05b-4986-a249-77486852bfe7

	measure 'Supplier OTD' =
		DIVIDE(
		    CALCULATE(
		        COUNTROWS(fact_shipments),
		        FILTER(fact_shipments, fact_shipments[actual_delivery_date_key] <= fact_shipments[expected_delivery_date_key])
		    ),
		    CALCULATE(COUNTROWS(fact_shipments), NOT ISBLANK(fact_shipments[actual_delivery_date_key]))
		)
		lineageTag: 6281cef2-1584-4057-9623-0a93a644cb43

	measure 'Transport Cost' = SUM(fact_shipments[transport_cost])
		lineageTag: 508acc46-d485-448d-a750-f69bca057294

	measure 'Cancellation Rate' =
		DIVIDE(
		    CALCULATE(COUNTROWS(fact_purchase_orders), fact_purchase_orders[order_status] = "Cancelled"),
		    COUNTROWS(fact_purchase_orders)
		)
		lineageTag: bc14697b-01ae-479a-a5a5-3d64040b86d5

	measure 'Cost Variability' =
		AVERAGEX(
		    VALUES(dim_supplier[supplier_key]),
		    DIVIDE(CALCULATE(STDEVX.P(fact_purchase_orders, fact_purchase_orders[unit_cost])), CALCULATE(AVERAGE(fact_purchase_orders[unit_cost])))
		)
		lineageTag: 499538ea-227c-4447-8486-5cc4d28d3bff

	measure 'Supplier Risk Score' = AVERAGE(supplier_risk_scores[risk_score])
		lineageTag: 36d46e51-3b9a-4e54-b547-643ddb3a6ef6

	measure 'Supplier Risk Level' = SELECTEDVALUE(supplier_risk_scores[risk_level])
		lineageTag: 0ca0a025-c78e-4564-953f-34582d950010

	measure 'Baseline Avg Daily Demand' = DIVIDE([Total Units Sold], DISTINCTCOUNT(fact_sales[date_key]))
		lineageTag: b9f50cfc-7deb-45c4-816c-2ed356357468

	measure 'Baseline Daily Demand Std' =
		STDEVX.P(
		    ADDCOLUMNS(VALUES(dim_date[full_date]), "@DailyQty", CALCULATE(SUM(fact_sales[quantity]))),
		    [@DailyQty]
		)
		lineageTag: e7baec2d-120c-4f62-8833-13015778a76a

	measure 'Baseline Avg Lead Time' = [Average Lead Time]
		lineageTag: 6a4c21b9-9e71-465f-9511-b29251c00274

	measure 'Baseline Stockout Rate' = [Stockout Rate]
		lineageTag: 4d24a864-3ba4-405a-b4fb-8c2720aff43e

	measure 'Baseline Inventory Value' = [Inventory Value]
		lineageTag: bb22cb62-9d15-4852-b7c7-cbaf00c935f0

	measure 'Baseline Transport Cost' = [Transport Cost]
		lineageTag: 55a66ade-c3de-4da3-8af2-bced381e6b8b

	measure 'Baseline Revenue' = [Total Revenue]
		lineageTag: ac810eb9-a803-46a8-a613-c076b07415d5

	measure 'Demand Change % Value' = SELECTEDVALUE('Demand Change Parameter'[Demand Change %], 0)
		lineageTag: d3ec5b17-73c1-425b-a322-6cbd2a006e7b

	measure 'Lead Time Change % Value' = SELECTEDVALUE('Lead Time Change Parameter'[Lead Time Change %], 0)
		lineageTag: e879c934-0dc9-4b22-a885-38d28e8565ff

	measure 'Transport Cost Change % Value' = SELECTEDVALUE('Transport Cost Change Parameter'[Transport Cost Change %], 0)
		lineageTag: 02fdcdb6-d6aa-4b7d-8466-d7b192940b91

	measure 'Scenario Demand Factor' = 1 + DIVIDE([Demand Change % Value], 100)
		lineageTag: 1e9bfa77-6bff-4d07-8fae-31132f57f718

	measure 'Scenario Lead Time Factor' = 1 + DIVIDE([Lead Time Change % Value], 100)
		lineageTag: 5baf0851-afa3-452b-937e-2bbb947abdee

	measure 'Scenario Cost Factor' = 1 + DIVIDE([Transport Cost Change % Value], 100)
		lineageTag: ee89ec35-56f2-4ca4-9000-828f342ed3bb

	measure 'Implied Safety Stock' =
		VAR Mean = [Baseline Avg Daily Demand] * [Baseline Avg Lead Time]
		VAR Std = [Baseline Daily Demand Std] * SQRT([Baseline Avg Lead Time])
		VAR Rate = MIN(MAX([Baseline Stockout Rate], 0.0001), 0.9999)
		VAR P = 1 - Rate // z = ppf(1 - rate), per engine.py
		VAR PLow = 0.02425
		VAR PHigh = 1 - PLow
		VAR QLow = SQRT(-2 * LN(P))
		VAR ZLowTail =
		    (((((-0.007784894002430293 * QLow - 0.3223964580411365) * QLow - 2.400758277161838) * QLow
		        - 2.549732539343734) * QLow + 4.374664141464968) * QLow + 2.938163982698783)
		    / ((((0.007784695709041462 * QLow + 0.3224671290700398) * QLow + 2.445134137142996) * QLow
		        + 3.754408661907416) * QLow + 1)
		VAR QMid = P - 0.5
		VAR RMid = QMid * QMid
		VAR ZMid =
		    (((((-39.69683028665376 * RMid + 220.9460984245205) * RMid - 275.9285104469687) * RMid
		        + 138.3577518672690) * RMid - 30.66479806614716) * RMid + 2.506628277459239) * QMid
		    / (((((-54.47609879822406 * RMid + 161.5858368580409) * RMid - 155.6989798598866) * RMid
		        + 66.80131188771972) * RMid - 13.28068155288572) * RMid + 1)
		VAR QHigh = SQRT(-2 * LN(1 - P))
		VAR ZHighTail =
		    -(((((-0.007784894002430293 * QHigh - 0.3223964580411365) * QHigh - 2.400758277161838) * QHigh
		        - 2.549732539343734) * QHigh + 4.374664141464968) * QHigh + 2.938163982698783)
		    / ((((0.007784695709041462 * QHigh + 0.3224671290700398) * QHigh + 2.445134137142996) * QHigh
		        + 3.754408661907416) * QHigh + 1)
		VAR Z = IF(P < PLow, ZLowTail, IF(P > PHigh, ZHighTail, ZMid))
		RETURN Mean + Z * Std
		lineageTag: f6763516-3e62-4b0a-ac6b-9d7d5f5522b3

	measure 'Scenario Stockout Rate' =
		VAR DemandFactor = [Scenario Demand Factor]
		VAR LeadTimeFactor = [Scenario Lead Time Factor]
		VAR ScenarioMean = [Baseline Avg Daily Demand] * DemandFactor * ([Baseline Avg Lead Time] * LeadTimeFactor)
		VAR ScenarioStd = [Baseline Daily Demand Std] * DemandFactor * SQRT([Baseline Avg Lead Time] * LeadTimeFactor)
		VAR SafetyStock = [Implied Safety Stock]
		VAR Z = DIVIDE(SafetyStock - ScenarioMean, ScenarioStd)
		VAR AbsZ = ABS(Z)
		VAR T = DIVIDE(1, 1 + 0.2316419 * AbsZ)
		VAR Poly =
		    T * (0.319381530
		        + T * (-0.356563782
		        + T * (1.781477937
		        + T * (-1.821255978
		        + T * 1.330274429))))
		VAR Pdf = DIVIDE(1, SQRT(2 * PI())) * EXP(-0.5 * Z * Z)
		VAR UpperTail = Pdf * Poly
		VAR Phi = IF(Z >= 0, 1 - UpperTail, UpperTail) // standard normal CDF at Z
		VAR StockoutIfStdPositive = MIN(MAX(1 - Phi, 0), 1)
		RETURN IF(ScenarioStd > 0, StockoutIfStdPositive, IF(SafetyStock >= ScenarioMean, 0, 1))
		lineageTag: 7b53e3c8-8a43-4469-9674-2958244478a3

	measure 'Scenario Fill Rate' = 1 - [Scenario Stockout Rate]
		lineageTag: 34f91cd7-0f90-403a-b625-894d88cad649

	measure 'Scenario Projected Inventory Value' = [Baseline Inventory Value] * [Scenario Demand Factor] * [Scenario Lead Time Factor]
		lineageTag: 796a422b-1222-486b-abf4-2f8ac129c98a

	measure 'Scenario Projected Transport Cost' = [Baseline Transport Cost] * [Scenario Demand Factor] * [Scenario Cost Factor]
		lineageTag: 80abc6dc-2fcd-4c9f-8624-2807189bcfbd

	measure 'Scenario Projected Revenue' = [Baseline Revenue] * [Scenario Demand Factor]
		lineageTag: 65485150-4f26-4639-a433-e1554d3695a8

	measure 'Revenue at Risk' = [Scenario Projected Revenue] * [Scenario Stockout Rate]
		lineageTag: e10dd39d-1673-4857-8683-e14e3f2a7856
