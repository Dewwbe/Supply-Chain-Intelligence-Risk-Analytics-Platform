table 'Demand Change Parameter'
	lineageTag: a1b2c3d4-0002-4000-8000-000000000001
	isHidden: false

	column 'Demand Change %'
		dataType: int64
		isHidden: false
		lineageTag: a1b2c3d4-0002-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: '[Demand Change %]'

		annotation SummarizationSetBy = Automatic

	measure 'Demand Change % Value' = SELECTEDVALUE('Demand Change Parameter'[Demand Change %], 0)
		formatString: 0"%"

	partition 'Demand Change Parameter' = calculated
		mode: import
		source = ```
				GENERATESERIES(-20, 30, 1)
			```

	annotation __PBI_TemplateParameter = Demand Change %
	// Modeling > New Parameter > Numeric range in Desktop reproduces this
	// exactly (Min -20, Max 30, Increment 1, per ScenarioRequest's
	// demand_change_pct bounds in src/api/routers/scenario.py) — this is a
	// best-effort hand-authored equivalent of that Desktop feature.
