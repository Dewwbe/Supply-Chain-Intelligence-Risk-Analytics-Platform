					Typed = Table.TransformColumnTypes(Promoted, {{"shipment_key", Int64.Type}, {"source_system", type text}, {"shipment_source_id", type text}, {"supplier_key", Int64.Type}, {"warehouse_key", Int64.Type}, {"product_key", Int64.Type}, {"transport_key", Int64.Type}, {"order_date_key", Int64.Type}, {"expected_delivery_date_key", Int64.Type}, {"actual_delivery_date_key", Int64.Type}, {"quantity", Int64.Type}, {"transport_mode", type text}, {"transport_cost", type number}})
				in
