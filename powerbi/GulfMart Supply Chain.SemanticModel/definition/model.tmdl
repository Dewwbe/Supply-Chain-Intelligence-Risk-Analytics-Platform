model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US

	annotation __PBI_TimeIntelligenceEnabled = 1

	annotation PBI_QueryOrder = ["dim_date","dim_location","dim_product","dim_supplier","dim_warehouse","dim_customer","dim_store","dim_transport","fact_sales","fact_inventory","fact_shipments","fact_purchase_orders","fact_returns","supplier_risk_scores","Demand Change Parameter","Lead Time Change Parameter","Transport Cost Change Parameter","_Measures"]

// After opening in Power BI Desktop: Table view > dim_date > Mark as Date
// Table > Date Column = full_date. This one-click step is not
// hand-authored in TMDL here (its exact serialized form couldn't be
// verified without Desktop available in this environment) — DATEADD and
// SAMEPERIODLASTYEAR in powerbi/dax_measures.dax need it to work.
