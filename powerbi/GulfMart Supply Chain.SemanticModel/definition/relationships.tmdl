// supplier_risk_scores.supplier_id is (confusingly) the supplier's NAME,
// not a source id (see reports/supplier_risk/README.md /
// src/supplier_risk/scoring.py) — joins on dim_supplier[supplier_name],
// not a surrogate/source key, which is why this one relationship is
// text-to-text rather than key-to-key like every other one here.
relationship c1000001-0000-4000-8000-00000000001c
	fromColumn: supplier_risk_scores.supplier_id
	toColumn: dim_supplier.supplier_name
