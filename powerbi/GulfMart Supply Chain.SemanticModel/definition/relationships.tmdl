// One row per FK in database/schema/01_warehouse_star_schema.sql and
// 02_star_schema_extensions.sql. Where a fact table has more than one FK
// into dim_date (fact_shipments, fact_purchase_orders each have 3), only
// the order-date relationship is active — Power BI allows one active path
// between two tables; the others are inactive, and
// powerbi/dax_measures.dax's Average Lead Time measure resolves the
// second role-playing date via LOOKUPVALUE instead of USERELATIONSHIP.

relationship c1000001-0000-4000-8000-000000000001
	fromColumn: fact_sales.date_key
	toColumn: dim_date.date_key

relationship c1000001-0000-4000-8000-000000000002
